# ---------------------------------------------------------------------------
# Task Forge environment
# Copy to .env for local dev. On a host, set these as environment variables.
# Every one of these is read at runtime; DATABASE_URL is also needed at build
# time by `prisma generate`/`prisma migrate deploy`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public base URL of the web app. Used for links in emails and for the
# realtime server's CORS allow-list in production. No trailing slash.
APP_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
# Managed providers usually require SSL, e.g. ...?sslmode=require
DATABASE_URL="postgresql://taskforge:taskforge@localhost:5432/taskforge?schema=public"

# ---- Redis: realtime pub/sub + BullMQ queues ----
# Managed providers often use rediss:// (TLS).
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
# REQUIRED in production. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-in-production"
SESSION_COOKIE_NAME="tf_session"

# ---- Realtime service (apps/realtime) ----
REALTIME_PORT=4001
# Must be the public URL of the realtime service, reachable from the browser.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"

# ---- Email (SMTP). MailHog in dev; a real provider in production ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Task Forge <notifications@taskforge.dev>"

# ---- File uploads ----
# Attachments are written to apps/web/public/uploads on local disk.
# That does NOT survive on ephemeral/serverless filesystems (Vercel, Heroku,
# most container platforms) — attach a persistent volume or swap the handler
# in apps/web/src/app/api/tasks/[taskId]/attachments/route.ts for S3/R2.
MAX_UPLOAD_MB=25
