{
  "name": "task-forge",
  "private": true,
  "version": "0.1.0",
  "description": "Task Forge — organizations, workspaces, teams, projects, kanban boards, real-time collaboration.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:realtime": "npm run dev --workspace=apps/realtime",
    "dev:worker": "npm run dev --workspace=apps/worker",
    "build": "npm run build --workspace=packages/database && npm run build --workspace=apps/web",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:push": "npm run push --workspace=packages/database",
    "db:migrate": "npm run migrate --workspace=packages/database",
    "db:seed": "npm run seed --workspace=packages/database",
    "db:studio": "npm run studio --workspace=packages/database",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "tsc -b --pretty || true"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
